# Core paths and private GCS exchange
# Server credentials use Application Default Credentials/workload identity.
# GOOGLE_APPLICATION_CREDENTIALS is intentionally omitted: do not keep a
# service-account JSON file in the repository or copy one into job artifacts.
MATHULA_TV_WORK_DIR=/home/mokgethwa/mathula-tv/working
MATHULA_TV_GCS_BUCKET=
MATHULA_TV_GCS_PREFIX=mathula-tv
MATHULA_TV_LEASE_SECONDS=900
MATHULA_TV_MAX_ARTIFACT_DOWNLOAD_BYTES=2147483648
# Protected-job commands require this explicit acknowledgement when the server
# uses verified ADC/workload identity instead of GOOGLE_APPLICATION_CREDENTIALS.
MATHULA_TV_USE_APPLICATION_DEFAULT_CREDENTIALS=0

# Optional grounded context. Keep source files private and reviewed.
COMMISSION_MASTER_CASE_PATH=/home/mokgethwa/commission-ai/working/case_state/master_case_state.json
POLITICS_CONTEXT_PATH=/home/mokgethwa/mathula-tv/working/context/politics_context.json

# Production AI provider: Azure OpenAI GPT through the Responses API.
# Never commit the key. Both deployment variables may be set, but must agree.
MATHULA_TV_AI_PROVIDER=azure-openai-gpt
AZURE_AI_ENDPOINT=https://RESOURCE.services.ai.azure.com
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT=gpt-5.6-sol-1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-sol-1
MATHULA_TV_GPT_TIMEOUT_SECONDS=900
MATHULA_TV_GPT_MAX_RETRIES=3
MATHULA_TV_GPT_EFFORT=high
MATHULA_TV_GPT_MAX_OUTPUT_TOKENS=50000
MATHULA_TV_TRANSLATION_GPT_EFFORT=low
MATHULA_TV_SEO_GPT_EFFORT=medium
MATHULA_TV_HOOK_GPT_EFFORT=low
MATHULA_TV_EDITORIAL_GPT_EFFORT=high
MATHULA_TV_MAX_TRANSLATION_REPAIRS=2

# Azure Speech-to-Text: authoritative en-ZA transcript and job-local diarization.
# AZURE_SPEECH_ENDPOINT is optional when AZURE_SPEECH_REGION is set.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_LOCALE=en-ZA
AZURE_SPEECH_MAX_SPEAKERS=10
AZURE_SPEECH_TIMEOUT_SECONDS=600
MATHULA_TV_MAX_SOURCE_DURATION_MINUTES=240

# Azure Text-to-Speech: candidate zu-ZA voices must still pass live discovery.
MATHULA_TV_AZURE_TTS_VOICES=zu-ZA-ThandoNeural,zu-ZA-ThembaNeural
MATHULA_TV_AZURE_TTS_DEFAULT_VOICE=zu-ZA-ThandoNeural
MATHULA_TV_AZURE_TTS_SAMPLE_RATE=24000
MATHULA_TV_AZURE_TTS_CHANNELS=1
MATHULA_TV_AZURE_TTS_SAMPLE_WIDTH=2
MATHULA_TV_AZURE_TTS_TIMEOUT_SECONDS=120
MATHULA_TV_AZURE_TTS_MAX_RETRIES=3
MATHULA_TV_AZURE_RATE_MIN_PERCENT=-12
MATHULA_TV_AZURE_RATE_MAX_PERCENT=15
MATHULA_TV_AZURE_RATE_SEARCH_ATTEMPTS=3
MATHULA_TV_PREFERRED_END_TOLERANCE_MS=120

# OpenVoice worker. Set an immutable reviewed 40-character commit SHA before a live plan.
# The normal server must also know the reviewed checkpoint name/SHA identities
# before either GCS queue. Use a JSON object such as {"converter":"64-hex"};
# private worker materialisation paths do not belong in server configuration.
MATHULA_TV_OPENVOICE_REVISION=
MATHULA_TV_OPENVOICE_CHECKPOINT_HASHES_JSON=
MATHULA_TV_OPENVOICE_MAX_ATTEMPTS=2
MATHULA_TV_POST_CONVERSION_MIN_SPEED=0.94
MATHULA_TV_POST_CONVERSION_MAX_SPEED=1.06
MATHULA_TV_FINAL_TIMING_TOLERANCE_MS=120

# GPU-notebook runtime contract (set in the private GPU runtime, not the
# normal server .env). Values remain commented to prevent accidental live use.
# MATHULA_TV_JOB_ID=
# MATHULA_TV_WORKER_ID=
# MATHULA_TV_GCP_PROJECT=
# MATHULA_TV_REPOSITORY_URL=
# MATHULA_TV_REPOSITORY_COMMIT=  # exact 40-character commit
# MATHULA_TV_OPENVOICE_REPOSITORY_URL=
# MATHULA_TV_OPENVOICE_WORKER_MODE=  # assets or conversion
# MATHULA_TV_OPENVOICE_ASSET_PLAN_SHA256=
# MATHULA_TV_OPENVOICE_PLAN_SHA256=
# MATHULA_TV_OPENVOICE_PYTHON_VERSION=
# MATHULA_TV_OPENVOICE_TORCH_VERSION=
# MATHULA_TV_OPENVOICE_RUNTIME_FACTORY=module:function
# MATHULA_TV_OPENVOICE_CANDIDATE_EVALUATOR_FACTORY=module:function
# MATHULA_TV_OPENVOICE_REQUIREMENTS_JSON=["package==exact-version"]
# In the private GPU runtime, set MATHULA_TV_OPENVOICE_CHECKPOINTS_JSON to the
# same reviewed names/SHA-256 values plus worker-only filename/source_path:
# [{"name":"name","filename":"file","source_path":"private-path","sha256":"64-hex"}]
# MATHULA_TV_OPENVOICE_PRECISION=fp16
# Optional explicit reclaim/attempt number; normally derive it from job status.
# MATHULA_TV_OPENVOICE_ATTEMPT=
# MATHULA_TV_LIVE_OPERATION=0
# MATHULA_TV_LIVE_OPERATION_ACK=
# Kaggle only: store service-account JSON in the Kaggle secret named
# MATHULA_TV_GCP_SERVICE_ACCOUNT_JSON; never place the JSON in this file.

# Mixing and QC policy
MATHULA_TV_TARGET_LUFS=-14
MATHULA_TV_TRUE_PEAK_DBTP=-1.5
MATHULA_TV_TARGET_LRA=11

# Bounded attempts, cost, and runtime
MATHULA_TV_MAX_AI_CALLS_PER_JOB=20
MATHULA_TV_MAX_TRANSLATION_REPAIRS_PER_UNIT=2
MATHULA_TV_MAX_AZURE_TTS_ATTEMPTS_PER_UNIT=3
MATHULA_TV_MAX_OPENVOICE_ATTEMPTS_PER_UNIT=2
MATHULA_TV_MAX_FAILED_UNITS=2
MATHULA_TV_MAX_JOB_RUNTIME_SECONDS=14400

# Optional Pyannote diagnostic/comparison path. Azure labels remain authoritative.
MATHULA_TV_ENABLE_PYANNOTE_DIAGNOSTIC=0
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=
MATHULA_TV_SPEAKER_TOLERANCE_SECONDS=0.35

# Explicit, paid/live integration-test opt-ins. Leave disabled for normal tests.
MATHULA_TV_RUN_LIVE_AZURE_STT_TESTS=0
MATHULA_TV_RUN_LIVE_AZURE_TTS_TESTS=0
MATHULA_TV_RUN_LIVE_AZURE_OPENAI_TESTS=0
MATHULA_TV_RUN_LIVE_GCS_TESTS=0
MATHULA_TV_RUN_LIVE_OPENVOICE_TESTS=0
MATHULA_TV_RUN_LIVE_RENDER_TESTS=0
MATHULA_TV_RUN_LIVE_FOUR_TURN_TESTS=0

# Live-fixture inputs and injected runners. A flag plus its exact reviewed
# fixture/runner is required; blank runners skip rather than inventing work.
MATHULA_TV_LIVE_AZURE_STT_AUDIO=
MATHULA_TV_LIVE_STT_LOCALE=zu-ZA
MATHULA_TV_OPENVOICE_LIVE_TEST_RUNNER=
MATHULA_TV_OPENVOICE_ASSET_LIVE_TEST_RUNNER=
MATHULA_TV_SPEAKER_SIMILARITY_LIVE_TEST_RUNNER=
MATHULA_TV_GCS_RECOVERY_LIVE_TEST_RUNNER=
MATHULA_TV_RENDER_LIVE_TEST_RUNNER=
MATHULA_TV_FOUR_TURN_LIVE_TEST_RUNNER=

# Azure Fast source-transcription entity phrase list
MATHULA_TV_STT_ENTITY_REGISTRY=config/entity_registry.json
MATHULA_TV_STT_PHRASE_OVERRIDES=config/stt_phrase_overrides.json
MATHULA_TV_STT_MAX_PHRASES=450
MATHULA_TV_STT_PHRASE_BIASING_WEIGHT=1.6

# Post-TTS production QA is enabled by default by the dub-azure command. It
# transcribes the rendered isiZulu mix, measures delivery-aware WER, protected
# identities, pauses, tempo and speaker collisions, and blocks publication on
# failure. CLI flags can override these values per run.
MATHULA_TV_POST_TTS_QA_ENABLED=1
MATHULA_TV_POST_TTS_QA_MAX_ROUNDS=1
MATHULA_TV_POST_TTS_QA_MINIMUM_PRODUCTION_SCORE=82
MATHULA_TV_POST_TTS_QA_MAXIMUM_AGGREGATE_WER=0.40

# PostgreSQL-backed transcript autocorrect. This may point to the same
# PostgreSQL server used by commission-ai; Mathula TV uses a separate schema.
MATHULA_TV_DATABASE_URL=
MATHULA_TV_DATABASE_SCHEMA=mathula_autocorrect

# Constrained GPT ranking for deterministic STT correction candidates. GPT can
# only select a candidate already produced by the local detector; it cannot
# invent replacement text. Disable for deterministic-only autocorrection.
MATHULA_TV_AUTOCORRECT_AI_ENABLED=1
MATHULA_TV_AUTOCORRECT_AI_MAXIMUM_CORRECTIONS=100
MATHULA_TV_AUTOCORRECT_AI_AUTO_APPLY_CONFIDENCE=0.92
MATHULA_TV_AUTOCORRECT_AI_MINIMUM_CANDIDATE_SCORE=0.75

# Random private salt used to pseudonymise opted-in public dictionary evidence.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MATHULA_TV_FEEDBACK_HASH_SALT=

# Self-hosted NLLB-200 3.3B translation Space(s), used by `native-translate
# --candidate-pool` as a second translator alongside Grok (see
# nllb_space_client.py). MATHULA_TV_NLLB_SPACE_URL is the always-on HF ZeroGPU
# Space; MATHULA_TV_NLLB_SPACE_URLS (comma-separated) configures a POOL of
# providers instead -- e.g. that same Space plus an ad-hoc Kaggle-notebook
# mirror's temporary share URL -- so one job's NLLB workload can draw on more
# than one provider's independent daily GPU quota. Leave both blank to run
# --candidate-pool Grok-only.
MATHULA_TV_NLLB_SPACE_URL=
MATHULA_TV_NLLB_SPACE_URLS=
MATHULA_TV_NLLB_SPACE_TOKEN=
MATHULA_TV_NLLB_TIMEOUT_SECONDS=600
MATHULA_TV_NLLB_MAX_RETRIES=2
MATHULA_TV_NLLB_CONSECUTIVE_FAILURE_LIMIT=2
