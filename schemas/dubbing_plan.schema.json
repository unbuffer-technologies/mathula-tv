{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathula.tv/schemas/dubbing_plan.schema.json",
  "title": "Mathula TV dubbing plan",
  "type": "object",
  "required": ["schema_version", "job_id", "source_media", "analysis_audio", "mix_source_audio", "units", "compatibility", "artifact_sha256"],
  "properties": {
    "schema_version": {"const": "dubbing-plan-v1"},
    "job_id": {"type": "string", "minLength": 1},
    "source_media": {"$ref": "#/$defs/artifact"},
    "analysis_audio": {"$ref": "#/$defs/artifact"},
    "mix_source_audio": {"$ref": "#/$defs/artifact"},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "speaker_id", "faithful_translation", "spoken_text", "tts_text", "preferred_duration_ms", "maximum_duration_ms", "azure_tts", "openvoice", "alignment"]
      }
    },
    "compatibility": {"type": "object", "required": ["state"]},
    "artifact_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
