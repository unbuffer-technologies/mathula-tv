{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathula.tv/schemas/compatibility_report.schema.json",
  "title": "Azure TTS to OpenVoice compatibility report",
  "type": "object",
  "required": ["schema_version", "job_id", "state", "gate_state", "production_ready", "thresholds", "units", "human_review_required"],
  "properties": {
    "schema_version": {"const": "azure-openvoice-compatibility-report-v1"},
    "job_id": {"type": "string"},
    "state": {"enum": ["pending", "passed", "failed_pronunciation", "failed_intelligibility", "failed_identity", "failed_timing", "failed_audio_quality", "needs_human_review"]},
    "gate_state": {"type": "string"},
    "production_ready": {"const": false},
    "thresholds": {"type": "object"},
    "units": {"type": "array", "minItems": 1},
    "human_review_required": {"const": true}
  }
}
